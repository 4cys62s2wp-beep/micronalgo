# Kopieren nach .env und ausfüllen. .env steht in .gitignore.

# --- Broker (Alpaca Paper) -------------------------------------------------
# Schlüssel erzeugen unter https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

MICRONALGO_BROKER=alpaca
MICRONALGO_ALPACA_BASE_URL=https://paper-api.alpaca.markets
MICRONALGO_ALPACA_DATA_FEED=iex

# --- Sicherheit ------------------------------------------------------------
# dry_run=true protokolliert Orders, sendet sie aber NICHT. Standard ist true.
MICRONALGO_DRY_RUN=true
MICRONALGO_KILL_SWITCH_FILE=state/KILL

# Echtes Geld ist zusaetzlich durch diese Zeile gesperrt. Nicht setzen,
# solange docs/GO_LIVE_CHECKLIST.md nicht vollstaendig erfuellt ist.
# MICRONALGO_LIVE_TRADING_ACK=I UNDERSTAND THIS IS REAL MONEY

# --- Positionsgroesse ------------------------------------------------------
MICRONALGO_SYMBOL=MU
MICRONALGO_CAPITAL_FRACTION=0.95
MICRONALGO_LEVERAGE=1.0
MICRONALGO_MAX_NOTIONAL=250000

# --- Risiko ----------------------------------------------------------------
MICRONALGO_MAX_DRAWDOWN_HALT=0.25
MICRONALGO_DAILY_LOSS_LIMIT=0.05
MICRONALGO_MAX_CONSECUTIVE_LOSSES=12
MICRONALGO_MAX_PRICE_DEVIATION=0.35

# --- Optional --------------------------------------------------------------
# TIINGO_API_KEY=
# MICRONALGO_NOTIFY_WEBHOOK=https://hooks.slack.com/services/...
